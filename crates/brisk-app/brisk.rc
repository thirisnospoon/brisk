// Windows resources: the icon (GPUI loads resource ID 1 as the window icon) and version info.
1 ICON "../../assets/brisk.ico"

1 VERSIONINFO
FILEVERSION 0,2,6,0
PRODUCTVERSION 0,2,6,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Brisk"
      VALUE "FileDescription", "Brisk IDE"
      VALUE "FileVersion", "0.2.6"
      VALUE "InternalName", "brisk"
      VALUE "OriginalFilename", "brisk.exe"
      VALUE "ProductName", "Brisk"
      VALUE "ProductVersion", "0.2.6"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
